{
  "manifest_version": 3,
  "name": "Jumpinto IELTS Answer Reset",
  "description": "Clear or randomize your saved answers on jumpinto.com IELTS practice tests.",
  "version": "1.0.0",
  "permissions": ["storage"],
  "host_permissions": ["https://www.jumpinto.com/*"],
  "content_scripts": [
    {
      "matches": ["https://www.jumpinto.com/ielts/practice/*"],
      "js": ["src/lib/api.js", "src/lib/randomize.js", "src/content/index.js"],
      "css": ["src/content/panel.css"],
      "run_at": "document_idle"
    }
  ]
}
